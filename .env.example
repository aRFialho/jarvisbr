# Idioma e voz
JARVIS_LANGUAGE=pt
JARVIS_TTS_RATE=185
JARVIS_WHISPER_MODEL=small

# Áudio
# Vazio = entrada padrão do Windows. Também aceita índice ou parte do nome.
JARVIS_INPUT_DEVICE=

# Gatilhos
# Palmas ficam preservadas, mas desligadas por padrão.
JARVIS_CLAP_ENABLED=false
JARVIS_CLAP_THRESHOLD=0.04
JARVIS_CLAP_SPIKE_RATIO=1.8
JARVIS_CLAP_MAX_RMS=0.40
JARVIS_CLAP_MIN_GAP=0.12
JARVIS_CLAP_MAX_GAP=0.95
JARVIS_CLAP_SETTLE=0.45
JARVIS_CLAP_COOLDOWN=1.8
JARVIS_CLAP_HIGH_FREQ_RATIO=0.16
JARVIS_CLAP_MAX_EVENT_MS=240
JARVIS_CLAP_ATTACK_RATIO=2.0

# Provider: auto | openjarvis | ollama | gemini | offline
JARVIS_PROVIDER=auto
JARVIS_OPENJARVIS_URL=http://127.0.0.1:8000/v1
JARVIS_OPENJARVIS_MODEL=qwen3.5:4b
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=qwen3.5:4b
GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=gemini-2.5-flash

# Segurança local
# Separe pastas por ; no Windows.
JARVIS_ALLOWED_DIRS=%USERPROFILE%\Documents;%USERPROFILE%\Downloads;%USERPROFILE%\Desktop
JARVIS_ALLOW_SHELL=false
JARVIS_SHELL_ALLOWLIST=python;python.exe;py;git;node;npm;pnpm;uv;ollama

# Apps permitidos. Formato alias=executavel, separados por ;
JARVIS_APPS=chrome=chrome.exe;edge=msedge.exe;bloco de notas=notepad.exe;notepad=notepad.exe;calculadora=calc.exe;explorador=explorer.exe;vscode=code;spotify=spotify.exe
